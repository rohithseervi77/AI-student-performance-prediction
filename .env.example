# =============================================================================
# EduPredict AI — Environment Configuration Example
# =============================================================================

# Database Connection URL:
# For MySQL: mysql+pymysql://<user>:<password>@<host>:3306/<database_name>
# Example: mysql+pymysql://root:password123@localhost:3306/edupredict_db
# For SQLite (default local fallback): sqlite:///./edupredict.db
DATABASE_URL=sqlite:///./edupredict.db

# JWT Security
JWT_SECRET=super-secret-academic-edupredict-key-2026-xyz-ai-token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000/api
